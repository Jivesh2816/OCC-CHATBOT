# Required — Groq API key (https://console.groq.com)
GROQ_API_KEY=

# Enables the staff queue at /#/staff. Use a long random string.
# Unset = staff routes return 503 (disabled), never open.
STAFF_TOKEN=

# Optional — hosted SQLite (Turso/libSQL). Needed on Vercel for tickets and
# staff replies to persist; without it, data lives in a local file (/tmp on Vercel).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional — override the local SQLite file location.
# SQLITE_PATH=
