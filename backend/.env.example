# Required — Groq API key (https://console.groq.com)
GROQ_API_KEY=

# Enables the staff queue at /#/staff. Use a long random string.
# Unset = staff routes return 503 (disabled), never open.
STAFF_TOKEN=

# Optional — hosted SQLite (Turso/libSQL). Needed on Vercel for tickets and
# staff replies to persist; without it, data lives in a local file (/tmp on Vercel).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional — override the local SQLite file location.
# SQLITE_PATH=

# Recommended — alert staff on every escalation. Slack or Discord incoming webhook.
# Without an alert channel, the crisis reply does not promise human follow-up.
STAFF_ALERT_WEBHOOK_URL=
# Optional — email alerts (smtps://user:pass@host:465) to this address.
SMTP_URL=
STAFF_ALERT_EMAIL=
# Link used in alerts; defaults to the deployed frontend's /#/staff.
# STAFF_DASHBOARD_URL=

# Optional — per-IP rate limits (defaults shown).
# RATE_LIMIT_CHAT_PER_MIN=12
# RATE_LIMIT_CHAT_PER_HOUR=100
# RATE_LIMIT_TOOLS_PER_MIN=5
# RATE_LIMIT_TOOLS_PER_HOUR=30
# RATE_LIMIT_STAFF_PER_MIN=60
